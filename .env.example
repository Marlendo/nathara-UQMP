# Database — staging via file env VPS (JANGAN commit nilai asli)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:54331/DBNAME

# SSO Supabase PROD (IdP: https://api.nathara.ac.id)
# service_role HARAM. JWT_SECRET lama HARAM dipakai lagi.
SUPABASE_URL=https://api.nathara.ac.id
# publishable/anon key prod — nilai via file env VPS, JANGAN commit
SUPABASE_ANON_KEY=
# Kontrak PM-0246 FINAL
SSO_ISSUER_URL=https://sso.nathara.ac.id
SSO_JWKS_URL=https://api.nathara.ac.id/functions/v1/sso-jwks
# GAP B2: aud BELUM ada di kontrak — kosongkan; JANGAN karang nilai.
# Bila kontrak B2 FINAL, isi exact lalu eskalasi PM.
SSO_AUDIENCE=
# client id = anon/publishable key prod (via file env VPS)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Callback allowlist exact (sudah live di bundle portal post-redeploy)
SSO_CALLBACK_URL=https://pjm.nathara.ac.id/api/auth/sso/callback
# Allowlist sub (UUID, koma) untuk provision admin/UQMP — via file env VPS
UQMP_SSO_ALLOWLIST_SUBS=

# Kunci sesi app baru untuk audit-link signing (min 32 char, via file env VPS)
# Generate: openssl rand -hex 48
UQMP_LINK_SECRET=

# AI Provider — NON-AKTIF default (dikosongkan eksplisit; DILARANG aktif
# tanpa spec + secret resmi)
AI_PROVIDER_TYPE=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=
